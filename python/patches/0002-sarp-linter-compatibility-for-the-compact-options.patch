index 0000000000..6a0adbc1a9
--- /dev/null
+++ b/crates/ruff_workspace/src/compact.rs
@@ -0,0 +1,110 @@
+//! Fork-owned glue for the compact formatting options.
+//!
+//! Everything in this file is specific to this fork and has no upstream counterpart. Keeping
+//! it here — rather than inline in `configuration.rs` — means an upstream sync conflicts on a
+//! single call site instead of a forty-line block wedged inside `Configuration::into_settings`.
+
+use ruff_python_formatter::CompactOptions;
+
+use crate::configuration::FormatConfiguration;
+
+/// Resolve the user's `[format]` compact options against the defaults.
+///
+/// Mirrors how `into_settings` resolves every other formatter option: an explicitly configured
+/// value wins, otherwise the default carries through.
+pub(crate) fn resolve_compact_options(
+    format: &FormatConfiguration,
+    defaults: &CompactOptions,
+) -> CompactOptions {
+    CompactOptions::default()
+        .with_annotation_spacing(
+            format
+                .annotation_spacing
+                .unwrap_or(defaults.annotation_spacing()),
+        )
+        .with_top_level_blank_lines(
+            format
+                .top_level_blank_lines
+                .unwrap_or(defaults.top_level_blank_lines()),
+        )
+        .with_operator_spacing(
+            format
+                .operator_spacing
+                .unwrap_or(defaults.operator_spacing()),
+        )
+        .with_dict_spacing(format.dict_spacing.unwrap_or(defaults.dict_spacing()))
+        .with_slice_spacing(format.slice_spacing.unwrap_or(defaults.slice_spacing()))
+        .with_nested_blank_lines(
+            format
+                .nested_blank_lines
+                .unwrap_or(defaults.nested_blank_lines()),
+        )
+        .with_default_value_spacing(
+            format
+                .default_value_spacing
+                .unwrap_or(defaults.default_value_spacing()),
+        )
+        .with_import_trailing_comma(
+            format
+                .import_trailing_comma
+                .unwrap_or(defaults.import_trailing_comma()),
+        )
+        .with_comment_blank_lines(
+            format
+                .comment_blank_lines
+                .unwrap_or(defaults.comment_blank_lines()),
+        )
+}
+
+/// Propagate compact formatter options into the pycodestyle linter settings.
+///
+/// Without this, rules like `E225`/`E231`/`E301` flag the formatter's own compact output and
+/// `ruff format` and `ruff check --fix` fight each other indefinitely. Each option relaxes
+/// exactly the rules whose expectations it contradicts.
+pub(crate) fn propagate_to_pycodestyle(
+    compact: &CompactOptions,
+    pcs: &mut ruff_linter::rules::pycodestyle::settings::Settings,
+) {
+    if compact.top_level_blank_lines().is_one() {
+        pcs.compact.top_level_blank_lines = 1;
+    }
+    if compact.nested_blank_lines().is_zero() {
+        pcs.compact.nested_blank_lines = 0;
+    }
+    if compact.operator_spacing().is_precedence() {
+        pcs.compact.operator_spacing_precedence = true;
+    }
+    if compact.annotation_spacing().is_compact() {
+        pcs.compact.annotation_spacing_compact = true;
+    }
+    if compact.dict_spacing().is_compact() {
+        pcs.compact.dict_spacing_compact = true;
+    }
+    if compact.default_value_spacing().is_compact() {
+        pcs.compact.default_value_spacing_compact = true;
+    }
+    if compact.import_trailing_comma().is_never() {
+        pcs.compact.import_trailing_comma_never = true;
+    }
+}
+
+/// Reconcile isort's `lines-after-imports` with `top-level-blank-lines = "one"`.
+///
+/// isort would otherwise insert two blank lines after the import block while the formatter
+/// collapses them to one, causing `format` and `check --fix` to cycle. Only applies when the
+/// user has not set `lines-after-imports` explicitly (`-1` is isort's "unset" sentinel).
+pub(crate) fn reconcile_isort(
+    compact: &CompactOptions,
+    isort: &mut ruff_linter::rules::isort::settings::Settings,
+) {
+    if compact.top_level_blank_lines().is_one() && isort.lines_after_imports == -1 {
+        isort.lines_after_imports = 1;
+    }
+
+    // I001 rewrites wrapped import blocks itself, appending a comma after every alias. With
+    // `import-trailing-comma = "never"` the formatter then strips that comma straight back off,
+    // so the two oscillate. Teach isort to stop emitting it.
+    if compact.import_trailing_comma().is_never() {
+        isort.emit_trailing_comma = false;
+    }
+}
