diff --git a/crates/ruff_linter/src/rules/pycodestyle/compact.rs b/crates/ruff_linter/src/rules/pycodestyle/compact.rs
new file mode 100644
index 0000000000..eb1523439f
--- /dev/null
+++ b/crates/ruff_linter/src/rules/pycodestyle/compact.rs
@@ -0,0 +1,140 @@
+//! Fork-owned pycodestyle settings that mirror the formatter's compact options.
+//!
+//! These have no upstream counterpart. They are populated in `ruff_workspace` from the
+//! `[format]` compact options so that pycodestyle rules stop flagging the formatter's own
+//! output — without them `ruff format` and `ruff check --fix` fight each other indefinitely.
+//!
+//! Holding them in their own struct keeps upstream's `pycodestyle::settings::Settings` to a
+//! single added field, and lets it keep deriving `Default` rather than needing a hand-written
+//! impl just to express the non-zero blank-line defaults.
+
+use std::fmt;
+
+use ruff_macros::CacheKey;
+use ruff_python_ast::token::TokenKind;
+
+use crate::display_settings;
+
+#[derive(Debug, Clone, CacheKey)]
+#[expect(
+    clippy::struct_excessive_bools,
+    reason = "each flag mirrors one independent formatter option"
+)]
+pub struct CompactSettings {
+    /// Expected blank lines between top-level definitions (default 2, set to 1 when
+    /// `format.top-level-blank-lines = "one"`). Consulted by E302/E303/E305.
+    pub top_level_blank_lines: u32,
+    /// Expected blank lines between nested definitions (default 1, set to 0 when
+    /// `format.nested-blank-lines = "zero"`). Consulted by E301/E306.
+    pub nested_blank_lines: u32,
+    /// When true, E225 allows missing spaces around high-precedence operators
+    /// (`*`, `/`, `//`, `%`, `**`, `@`). Set from `format.operator-spacing = "precedence"`.
+    pub operator_spacing_precedence: bool,
+    /// When true, E225 allows missing spaces around `->` and E231 allows missing space
+    /// after `:` in annotations. Set from `format.annotation-spacing = "compact"`.
+    pub annotation_spacing_compact: bool,
+    /// When true, E231 allows missing space after `:` in dict literals.
+    /// Set from `format.dict-spacing = "compact"`.
+    pub dict_spacing_compact: bool,
+    /// When true, E251 allows no spaces around `=` in annotated parameter defaults.
+    /// Set from `format.default-value-spacing = "compact"`.
+    pub default_value_spacing_compact: bool,
+    /// When true, COM812 does not flag missing trailing commas in import statements.
+    /// Set from `format.import-trailing-comma = "never"`.
+    pub import_trailing_comma_never: bool,
+}
+
+impl Default for CompactSettings {
+    fn default() -> Self {
+        Self {
+            // PEP 8 / Black defaults, so an unconfigured fork build lints as upstream does.
+            top_level_blank_lines: 2,
+            nested_blank_lines: 1,
+            operator_spacing_precedence: false,
+            annotation_spacing_compact: false,
+            dict_spacing_compact: false,
+            default_value_spacing_compact: false,
+            import_trailing_comma_never: false,
+        }
+    }
+}
+
+impl fmt::Display for CompactSettings {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        display_settings! {
+            formatter = f,
+            namespace = "linter.pycodestyle",
+            fields = [
+                self.top_level_blank_lines,
+                self.nested_blank_lines,
+                self.operator_spacing_precedence,
+                self.annotation_spacing_compact,
+                self.dict_spacing_compact,
+                self.default_value_spacing_compact,
+                self.import_trailing_comma_never,
+            ]
+        }
+        Ok(())
+    }
+}
+
+impl CompactSettings {
+    /// Whether `kind` is exempt from E225's "needs surrounding whitespace" requirement.
+    ///
+    /// Kept here rather than inline in `is_whitespace_needed` so that upstream's function
+    /// body gains a single guard call instead of a block of fork-specific branching.
+    pub fn exempts_whitespace(&self, kind: TokenKind) -> bool {
+        // `annotation-spacing = "compact"` writes `-> bool` as `->bool`.
+        if self.annotation_spacing_compact && kind == TokenKind::Rarrow {
+            return true;
+        }
+
+        // `*` and `**` are deliberately absent here: in this path the token may be a unary
+        // star (`*args`, `**kwargs`), where spacing is not the formatter's to relax. The
+        // binary case goes through `exempts_binary_whitespace` instead.
+        self.operator_spacing_precedence
+            && matches!(
+                kind,
+                TokenKind::Slash | TokenKind::DoubleSlash | TokenKind::Percent | TokenKind::At
+            )
+    }
+
+    /// Whether a bracket-free colon in a logical line beginning with `first` belongs to an
+    /// annotated assignment (`value:int = 3`, `self.attr:str = "x"`) rather than to a compound
+    /// statement (`if x:pass`, `for i in y:pass`).
+    ///
+    /// `annotation-spacing = "compact"` removes the space after annotation colons, so E231 has
+    /// to be relaxed for them — but only for them. Compound-statement colons are untouched by
+    /// the formatter and must keep reporting.
+    ///
+    /// Annotated assignments always start with a name; compound statements start with a
+    /// keyword. `match`, `case` and `type` are soft keywords that tokenise as names, so they
+    /// are excluded explicitly.
+    pub fn is_annotation_colon_line(&self, first: Option<TokenKind>, first_text: &str) -> bool {
+        self.annotation_spacing_compact
+            && first == Some(TokenKind::Name)
+            && !matches!(first_text, "match" | "case" | "type")
+    }
+
+    /// Whether `kind`, known to be used as a *binary* operator here, is exempt from the
+    /// whitespace requirement.
+    ///
+    /// Same set as [`Self::exempts_whitespace`] plus `*` and `**`, which are safe to include
+    /// because the caller has already established this is not a unary star.
+    ///
+    /// This covers E226/E227/E228 as well as E225. `operator-spacing = "precedence"` writes
+    /// `a/b` and `a%b`, and E226 and E228 flag exactly those, so relaxing only E225 would
+    /// leave `ruff check` complaining about output `ruff format` had just produced.
+    pub fn exempts_binary_whitespace(&self, kind: TokenKind) -> bool {
+        self.operator_spacing_precedence
+            && matches!(
+                kind,
+                TokenKind::Star
+                    | TokenKind::DoubleStar
+                    | TokenKind::Slash
+                    | TokenKind::DoubleSlash
+                    | TokenKind::Percent
+                    | TokenKind::At
+            )
+    }
+}
