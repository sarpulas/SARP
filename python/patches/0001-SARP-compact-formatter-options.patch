+            _ => Err("Value not supported for SliceSpacing"),
+        }
+    }
+}
+
+/// Controls blank lines between statements inside nested scopes (class bodies, function bodies).
+///
+/// * `One` (default): One blank line between class methods / nested definitions (Black-compatible).
+/// * `Zero`: No blank lines between class methods / nested definitions.
+#[derive(Copy, Clone, Debug, Eq, PartialEq, Default, CacheKey)]
+#[cfg_attr(
+    feature = "serde",
+    derive(serde::Serialize, serde::Deserialize),
+    serde(rename_all = "kebab-case")
+)]
+#[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+pub enum NestedBlankLines {
+    /// One blank line between nested definitions (PEP 8 / Black compatible).
+    #[default]
+    One,
+
+    /// No blank lines between nested definitions.
+    Zero,
+}
+
+impl NestedBlankLines {
+    pub const fn is_zero(self) -> bool {
+        matches!(self, NestedBlankLines::Zero)
+    }
