+/// Returns true if the comment contains `# noqa: E501` (or a noqa list including E501).
+/// This makes the formatter treat the line as verbatim, preventing line wrapping.
+fn has_noqa_e501(comment: &str) -> bool {
+    for segment in comment.split('#') {
+        let trimmed = segment.trim();
+        if let Some(codes) = trimmed.strip_prefix("noqa:") {
+            let codes = codes.trim();
+            if codes.split(',').any(|c| c.trim() == "E501") {
+                return true;
+            }
+        }
+    }
+    false
+}
