+/// Emit the configured number of blank lines for top-level separation.
+/// With `TopLevelBlankLines::Two` (default), emits two empty lines.
+/// With `TopLevelBlankLines::One`, emits a single empty line.
+fn top_level_empty_lines(f: &mut PyFormatter) -> FormatResult<()> {
+    if f.options().compact().top_level_blank_lines().is_one() {
