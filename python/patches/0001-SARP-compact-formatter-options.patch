+
+/// All fork-specific compact formatting options, carried as a single unit.
+///
+/// Bundling them means `PyFormatOptions` (and `FormatterSettings`) gain **one** field rather
+/// than nine interleaved ones, which keeps the fork's footprint inside upstream structs to a
+/// single line and makes upstream syncs near-mechanical.
+///
+/// Every field defaults to the Black/PEP 8 behaviour, so `CompactOptions::default()` is
+/// indistinguishable from upstream.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, CacheKey)]
+#[cfg_attr(
+    feature = "serde",
+    derive(serde::Serialize, serde::Deserialize),
+    serde(default, deny_unknown_fields, rename_all = "kebab-case")
+)]
+#[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+pub struct CompactOptions {
+    annotation_spacing: AnnotationSpacing,
+    top_level_blank_lines: TopLevelBlankLines,
+    operator_spacing: OperatorSpacing,
+    dict_spacing: DictSpacing,
+    slice_spacing: SliceSpacing,
+    nested_blank_lines: NestedBlankLines,
+    default_value_spacing: DefaultValueSpacing,
+    import_trailing_comma: ImportTrailingComma,
+    comment_blank_lines: CommentBlankLines,
+}
+
+impl CompactOptions {
+    pub const fn annotation_spacing(&self) -> AnnotationSpacing {
+        self.annotation_spacing
+    }
+
+    pub const fn top_level_blank_lines(&self) -> TopLevelBlankLines {
+        self.top_level_blank_lines
+    }
+
+    pub const fn operator_spacing(&self) -> OperatorSpacing {
+        self.operator_spacing
+    }
+
+    pub const fn dict_spacing(&self) -> DictSpacing {
+        self.dict_spacing
+    }
+
+    pub const fn slice_spacing(&self) -> SliceSpacing {
+        self.slice_spacing
+    }
+
+    pub const fn nested_blank_lines(&self) -> NestedBlankLines {
+        self.nested_blank_lines
+    }
+
+    pub const fn default_value_spacing(&self) -> DefaultValueSpacing {
+        self.default_value_spacing
+    }
+
+    pub const fn import_trailing_comma(&self) -> ImportTrailingComma {
+        self.import_trailing_comma
+    }
+
+    pub const fn comment_blank_lines(&self) -> CommentBlankLines {
+        self.comment_blank_lines
+    }
+
+    #[must_use]
+    pub fn with_annotation_spacing(mut self, value: AnnotationSpacing) -> Self {
+        self.annotation_spacing = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_top_level_blank_lines(mut self, value: TopLevelBlankLines) -> Self {
+        self.top_level_blank_lines = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_operator_spacing(mut self, value: OperatorSpacing) -> Self {
+        self.operator_spacing = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_dict_spacing(mut self, value: DictSpacing) -> Self {
+        self.dict_spacing = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_slice_spacing(mut self, value: SliceSpacing) -> Self {
+        self.slice_spacing = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_nested_blank_lines(mut self, value: NestedBlankLines) -> Self {
+        self.nested_blank_lines = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_default_value_spacing(mut self, value: DefaultValueSpacing) -> Self {
+        self.default_value_spacing = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_import_trailing_comma(mut self, value: ImportTrailingComma) -> Self {
+        self.import_trailing_comma = value;
+        self
+    }
+
+    #[must_use]
+    pub fn with_comment_blank_lines(mut self, value: CommentBlankLines) -> Self {
+        self.comment_blank_lines = value;
+        self
+    }
+}
+
+impl CompactOptions {
+    /// Render these options in `ruff check --show-settings` form, one `<prefix><name> = <value>`
+    /// line per option.
+    ///
+    /// `display_settings!` (defined in `ruff_linter`, which this crate cannot depend on) only
+    /// accepts single-identifier field paths, so it cannot reach through this struct. Callers
+    /// invoke this alongside the macro and pass their own namespace prefix, which keeps the
+    /// emitted output identical to when these nine were flat fields.
+    pub fn fmt_settings(&self, f: &mut fmt::Formatter<'_>, prefix: &str) -> fmt::Result {
+        writeln!(
+            f,
+            "{prefix}annotation_spacing = {}",
+            self.annotation_spacing
+        )?;
+        writeln!(
+            f,
+            "{prefix}top_level_blank_lines = {}",
+            self.top_level_blank_lines
+        )?;
+        writeln!(f, "{prefix}operator_spacing = {}", self.operator_spacing)?;
+        writeln!(f, "{prefix}dict_spacing = {}", self.dict_spacing)?;
+        writeln!(f, "{prefix}slice_spacing = {}", self.slice_spacing)?;
+        writeln!(
+            f,
+            "{prefix}nested_blank_lines = {}",
+            self.nested_blank_lines
+        )?;
+        writeln!(
+            f,
+            "{prefix}default_value_spacing = {}",
+            self.default_value_spacing
+        )?;
+        writeln!(
+            f,
+            "{prefix}import_trailing_comma = {}",
+            self.import_trailing_comma
+        )?;
+        writeln!(
+            f,
+            "{prefix}comment_blank_lines = {}",
+            self.comment_blank_lines
+        )
+    }
+}
