+//! Fork-owned "compact" formatting options.
+//!
+//! These options are specific to this fork and have no upstream counterpart. They live in
+//! their own module so that syncing with upstream `astral-sh/ruff` touches as little of
+//! upstream's own code as possible: `PyFormatOptions` carries a single `CompactOptions`
+//! field rather than nine interleaved ones, and every formatter call site reads its setting
+//! through `f.options().compact()`.
+//!
+//! Every option defaults to standard Black/PEP 8 behaviour, so an unconfigured fork build
+//! formats identically to upstream.
+
+use std::fmt;
+use std::str::FromStr;
+
+use ruff_macros::CacheKey;
+
+/// Controls spacing around type annotation colons (`:`) and return type arrows (`->`).
+///
+/// * `Spaced` (default): `def f(x: int) -> bool:` (Black-compatible)
+/// * `Compact`: `def f(x:int)->bool:` (no spaces around annotation punctuation)
+#[derive(Copy, Clone, Debug, Eq, PartialEq, Default, CacheKey)]
+#[cfg_attr(
+    feature = "serde",
+    derive(serde::Serialize, serde::Deserialize),
+    serde(rename_all = "kebab-case")
+)]
+#[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+pub enum AnnotationSpacing {
+    /// Standard spacing: `x: int`, `-> bool` (PEP 8 / Black compatible).
+    #[default]
+    Spaced,
+
+    /// Compact spacing: `x:int`, `->bool` (no spaces around annotation punctuation).
+    Compact,
+}
+
+impl AnnotationSpacing {
+    pub const fn is_compact(self) -> bool {
+        matches!(self, AnnotationSpacing::Compact)
+    }
+
+    pub const fn is_spaced(self) -> bool {
+        matches!(self, AnnotationSpacing::Spaced)
+    }
+}
+
+impl fmt::Display for AnnotationSpacing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Spaced => write!(f, "spaced"),
+            Self::Compact => write!(f, "compact"),
+        }
+    }
+}
+
+impl FromStr for AnnotationSpacing {
+    type Err = &'static str;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "spaced" | "Spaced" => Ok(Self::Spaced),
+            "compact" | "Compact" => Ok(Self::Compact),
+            _ => Err("Value not supported for AnnotationSpacing"),
+        }
+    }
+}
+
+/// Number of blank lines between top-level definitions (classes, functions).
+///
+/// * `Two` (default): PEP 8 / Black standard — two blank lines.
+/// * `One`: Single blank line between top-level definitions.
+#[derive(Copy, Clone, Debug, Eq, PartialEq, Default, CacheKey)]
+#[cfg_attr(
+    feature = "serde",
+    derive(serde::Serialize, serde::Deserialize),
+    serde(rename_all = "kebab-case")
+)]
+#[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+pub enum TopLevelBlankLines {
+    /// Two blank lines between top-level definitions (PEP 8 / Black).
+    #[default]
+    Two,
+
+    /// One blank line between top-level definitions.
+    One,
+}
+
+impl TopLevelBlankLines {
+    pub const fn is_one(self) -> bool {
+        matches!(self, TopLevelBlankLines::One)
+    }
+
+    pub const fn is_two(self) -> bool {
+        matches!(self, TopLevelBlankLines::Two)
+    }
+}
+
+impl fmt::Display for TopLevelBlankLines {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Two => write!(f, "two"),
+            Self::One => write!(f, "one"),
+        }
+    }
+}
+
+impl FromStr for TopLevelBlankLines {
+    type Err = &'static str;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "two" | "Two" | "2" => Ok(Self::Two),
+            "one" | "One" | "1" => Ok(Self::One),
+            _ => Err("Value not supported for TopLevelBlankLines"),
+        }
+    }
+}
+
+/// Controls spacing around binary operators based on their precedence.
+///
+/// * `Spaced` (default): Spaces around all binary operators (Black-compatible).
+/// * `Precedence`: No spaces around high-precedence operators (`**`, `*`, `/`, `//`, `%`, `@`);
+///   spaces around everything else.
+#[derive(Copy, Clone, Debug, Eq, PartialEq, Default, CacheKey)]
+#[cfg_attr(
+    feature = "serde",
+    derive(serde::Serialize, serde::Deserialize),
+    serde(rename_all = "kebab-case")
+)]
+#[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+pub enum OperatorSpacing {
+    /// Standard spacing: spaces around all binary operators (PEP 8 / Black compatible).
+    #[default]
+    Spaced,
+
+    /// Precedence-aware spacing: no spaces around `**`, `*`, `/`, `//`, `%`, `@`;
+    /// spaces around everything else.
+    Precedence,
+}
+
+impl OperatorSpacing {
+    pub const fn is_precedence(self) -> bool {
+        matches!(self, OperatorSpacing::Precedence)
+    }
+
+    pub const fn is_spaced(self) -> bool {
+        matches!(self, OperatorSpacing::Spaced)
+    }
+}
+
+impl fmt::Display for OperatorSpacing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Spaced => write!(f, "spaced"),
+            Self::Precedence => write!(f, "precedence"),
+        }
+    }
+}
+
+impl FromStr for OperatorSpacing {
+    type Err = &'static str;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "spaced" | "Spaced" => Ok(Self::Spaced),
+            "precedence" | "Precedence" => Ok(Self::Precedence),
+            _ => Err("Value not supported for OperatorSpacing"),
+        }
+    }
+}
+
