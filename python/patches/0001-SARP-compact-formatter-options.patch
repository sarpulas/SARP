+
+/// Controls spacing around colons in slice expressions.
+///
+/// * `Spaced` (default): Black-compatible behavior (spaces around colons for complex expressions).
+/// * `Compact`: Never add spaces around colons, even for complex expressions like `x[a():b()]`.
+#[derive(Copy, Clone, Debug, Eq, PartialEq, Default, CacheKey)]
+#[cfg_attr(
+    feature = "serde",
+    derive(serde::Serialize, serde::Deserialize),
+    serde(rename_all = "kebab-case")
+)]
+#[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+pub enum SliceSpacing {
+    /// Standard spacing: spaces around colons for complex slice expressions (Black compatible).
+    #[default]
+    Spaced,
+
+    /// Compact spacing: no spaces around colons, even for complex expressions.
+    Compact,
+}
+
+impl SliceSpacing {
+    pub const fn is_compact(self) -> bool {
+        matches!(self, SliceSpacing::Compact)
+    }
+
+    pub const fn is_spaced(self) -> bool {
+        matches!(self, SliceSpacing::Spaced)
+    }
+}
+
+impl fmt::Display for SliceSpacing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Spaced => write!(f, "spaced"),
+            Self::Compact => write!(f, "compact"),
+        }
+    }
+}
+
+impl FromStr for SliceSpacing {
+    type Err = &'static str;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "spaced" | "Spaced" => Ok(Self::Spaced),
